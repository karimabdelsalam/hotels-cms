# Copy to .env on the server. Four values are required; the rest have working
# defaults or are optional until you have the real credentials.
#
#   cp .env.docker.example .env && nano .env

# ---------- required ----------

# The two hostnames. Both must already point at this server's IP before you
# start, or Let's Encrypt cannot issue certificates.
PUBLIC_DOMAIN="ihotel.planova.com.eg"
ADMIN_DOMAIN="ihotel-admin.planova.com.eg"

# Where Let's Encrypt sends expiry warnings if renewal ever breaks.
ACME_EMAIL="you@planova.com.eg"

# Generate both:  openssl rand -base64 36
POSTGRES_PASSWORD=""
# Changing this signs every staff member out, which is also how you revoke a
# leaked session in a hurry. At least 32 characters.
AUTH_SECRET=""

# ---------- cache ----------
# Lets the admin clear the public site's cache the moment something is
# published, instead of waiting out the five minute window.
#   openssl rand -hex 24
REVALIDATE_SECRET=""

# ---------- first run ----------
# Demo content and generated images, seeded only into an empty database. Set to
# "no" once you have real content, so a rebuilt volume does not bring the
# placeholders back.
SEED_DEMO_CONTENT="yes"

# ---------- payments ----------
# "test" is a stand-in that always succeeds when you press Pay. It refuses to
# run in production unless ALLOW_TEST_PAYMENTS is set, which is the point:
# a payment page that always succeeds must never be reachable by accident.
#
# To go live: implement PaymentProvider in packages/booking/src/payment.ts for
# whichever provider you pick, set PAYMENT_PROVIDER to its name, and point its
# webhook at /api/payments/webhook. Nothing else changes.
PAYMENT_PROVIDER="test"
PAYMENT_TEST_SECRET="change-me"
ALLOW_TEST_PAYMENTS="yes"      # remove this line on the real site

# ---------- email ----------
# Optional. Left empty, confirmation emails queue in the outbox and wait —
# nothing is lost, but nothing reaches a guest either.
#
# Use an address on a domain that authorises this server to send as it (SPF,
# and DKIM if you can), or the messages go to spam.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="reservations@planova.com.eg"
RESERVATIONS_EMAIL="reservations@planova.com.eg"

# ---------- automatic translation ----------
# Optional. Without it the Translation Manager still works; the AI buttons say
# they are not configured rather than failing.
ANTHROPIC_API_KEY=""

# ---------- OPERA / OWS ----------
# Filled in from the WSDL your PMS team exports — see
# docs/opera-provisioning-runbook.md. Until then the booking flow runs against
# the built-in simulator.
# OPERA_PROD_USERNAME=""
# OPERA_PROD_PASSWORD=""
# OPERA_PROD_NS_RESERVATION=""
# OPERA_PROD_ACTION_CREATE=""
# OPERA_PROD_ACTION_FETCH=""
# OPERA_PROD_ACTION_CANCEL=""
