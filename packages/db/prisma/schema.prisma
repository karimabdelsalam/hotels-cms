// Fantazia Hotels & Resorts — central content model.
//
// Booking, payment, and OPERA integration entities are deliberately NOT here yet.
// They arrive in a later phase; see docs/booking-lifecycle.md and
// docs/property-integration.md. Nothing in this schema assumes a booking engine,
// and nothing here will need to change when one is added.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// LOCALES  —  languages are rows, never a constant in the code
// ============================================================

model Locale {
  code         String  @id @db.VarChar(12) // BCP 47: en, ar, de, ru, fr
  name         String // English name, e.g. "German"
  nativeName   String // endonym, e.g. "Deutsch"
  direction    String  @default("ltr") // ltr | rtl — a property of data, not an Arabic special case
  script       String  @default("latin") // latin | arabic | cyrillic — drives font subsetting
  isDefault    Boolean @default(false) // exactly one; protected from deletion
  isEnabled    Boolean @default(false) // public visibility; gated on completeness
  fallbackCode String? @db.VarChar(12) // null falls back to the default locale
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  strings              TranslationString[]
  destinationTrans     DestinationTranslation[]
  resortTrans          ResortTranslation[]
  roomTypeTrans        RoomTypeTranslation[]
  amenityTrans         AmenityTranslation[]
  restaurantTrans      RestaurantTranslation[]
  experienceTrans      ExperienceTranslation[]
  offerTrans           OfferTranslation[]
  pageTrans            PageTranslation[]
  mediaTrans           MediaAssetTranslation[]
  menuItemTrans        MenuItemTranslation[]

  @@index([isEnabled, displayOrder])

  cancellationPolicyTranslations CancellationPolicyTranslation[]
  ratePlanTranslations           RatePlanTranslation[]

  brandTrans           BrandTranslation[]
  facilityTrans        FacilityTranslation[]
  resortPolicyTrans    ResortPolicyTranslation[]
  faqTrans             FaqTranslation[]
  attractionTrans      NearbyAttractionTranslation[]
  venueTrans           VenueTranslation[]

  @@map("locales")
}

/// UI strings — buttons, labels, validation. Keys come from code, values from here.
model TranslationString {
  id         String  @id @default(cuid())
  namespace  String // common | search | booking | admin | email
  key        String // e.g. "nav.our_resorts"
  localeCode String  @db.VarChar(12)
  value      String
  status     String  @default("missing") // missing | machine | draft | translated | needs_review
  sourceHash String? // hash of the English value this was translated from — drift detection

  /// Set the moment a person saves this string. Automatic translation never
  /// touches a row where this is true, whatever its status — a human edit is
  /// permanent until a human changes it again.
  humanEdited  Boolean   @default(false)
  editedById   String?
  /// Provenance for machine output, so it is always clear what wrote a string.
  machineModel String?
  machineAt    DateTime?

  updatedAt  DateTime @updatedAt

  locale Locale @relation(fields: [localeCode], references: [code], onDelete: Cascade)
  editedBy User? @relation(fields: [editedById], references: [id], onDelete: SetNull)

  @@unique([namespace, key, localeCode])
  @@index([localeCode, status])
  @@index([localeCode, humanEdited])
  @@map("translation_strings")
}

// ============================================================
// SITE CONFIGURATION
// ============================================================

/// Homepage and navigation sections are feature flags, not markup.
/// `destinations` is off today: three resorts in one destination.
model SiteModule {
  key          String   @id // hero | destinations | resorts | reef | experiences | offers | weddings | newsletter
  enabled      Boolean  @default(true)
  displayOrder Int      @default(0)
  settings     Json     @default("{}")
  updatedAt    DateTime @updatedAt

  @@map("site_modules")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ============================================================
// MEDIA
// ============================================================

model MediaAsset {
  id         String  @id @default(cuid())
  storageKey String  @unique
  mime       String
  width      Int?
  height     Int?
  bytes      Int?
  /// A ~20px inline WebP data URI, so a card never reflows while its image loads.
  placeholder  String?
  originalName String?
  focalX     Float   @default(0.5) // every card crops the same image differently;
  focalY     Float   @default(0.5) // a face cropped out of frame is how a hotel site looks cheap

  /// Generated filler, not photography.
  ///
  /// Demo content has a habit of surviving into production, and a hotel group
  /// launching on abstract gradients is a bad day. Flagged in the library, and
  /// countable — so "how many placeholders are still live" is a question with
  /// an answer rather than a hunt.
  isPlaceholder Boolean @default(false)
  uploadedById String?
  createdAt  DateTime @default(now())

  translations MediaAssetTranslation[]
  uploadedBy   User?                   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  destinationHeroes Destination[] @relation("DestinationHero")
  resortHeroes      Resort[]      @relation("ResortHero")
  resortGallery     ResortMedia[]
  roomTypeMedia     RoomTypeMedia[]
  experienceHeroes  Experience[]  @relation("ExperienceHero")
  offerHeroes       Offer[]       @relation("OfferHero")
  restaurantHeroes  Restaurant[]  @relation("RestaurantHero")

  brandLogos        Brand[]            @relation("BrandLogo")
  brandHeroes       Brand[]            @relation("BrandHero")
  facilityHeroes    Facility[]         @relation("FacilityHero")
  attractionHeroes  NearbyAttraction[] @relation("AttractionHero")
  venueHeroes       Venue[]            @relation("VenueHero")
  venueGallery      VenueMedia[]
  restaurantMenus   Restaurant[]       @relation("RestaurantMenu")
  restaurantGallery RestaurantMedia[]

  @@map("media_assets")
}

model MediaAssetTranslation {
  id         String @id @default(cuid())
  mediaId    String
  localeCode String @db.VarChar(12)
  alt        String
  caption    String?

  media  MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  locale Locale     @relation(fields: [localeCode], references: [code], onDelete: Cascade)

  @@unique([mediaId, localeCode])
  @@map("media_asset_translations")
}

// ============================================================
// DESTINATIONS  —  entities even while the module is switched off
// ============================================================

model Destination {
  id           String  @id @default(cuid())
  code         String  @unique
  country      String  @default("EG")
  latitude     Float?
  longitude    Float?
  heroMediaId  String?
  displayOrder Int     @default(0)
  status       String  @default("published") // draft | published | archived

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  heroMedia    MediaAsset?              @relation("DestinationHero", fields: [heroMediaId], references: [id])
  translations DestinationTranslation[]
  resorts      Resort[]

  @@map("destinations")
}

model DestinationTranslation {
  id              String  @id @default(cuid())
  destinationId   String
  localeCode      String  @db.VarChar(12)
  name            String
  slug            String
  description     String?
  metaTitle       String?
  metaDescription String?

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  locale      Locale      @relation(fields: [localeCode], references: [code], onDelete: Cascade)

  @@unique([destinationId, localeCode])
  @@unique([localeCode, slug])
  @@map("destination_translations")
}

// ============================================================
// RESORTS
// ============================================================

model Resort {
  id            String  @id @default(cuid())
  code          String  @unique // maps to the OPERA resort code later
  destinationId String
  /// Optional: a single-brand group leaves this unset and nothing changes.
  brandId       String?
  starRating    Int?
  address       String?
  latitude      Float?
  longitude     Float?
  phone         String?
  email         String?
  checkInTime   String  @default("14:00")
  checkOutTime  String  @default("12:00")
  currency      String  @default("EGP")
  timezone      String  @default("Africa/Cairo")
  heroMediaId   String?
  displayOrder  Int     @default(0)
  status        String  @default("published")

  /// Indicative nightly rate in minor units (piastres) for display before the
  /// booking engine exists. Replaced by live rates in a later phase.
  fromRateMinor Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  destination  Destination         @relation(fields: [destinationId], references: [id])
  brand        Brand?              @relation(fields: [brandId], references: [id])
  heroMedia    MediaAsset?         @relation("ResortHero", fields: [heroMediaId], references: [id])
  translations ResortTranslation[]
  gallery      ResortMedia[]
  roomTypes    RoomType[]
  restaurants  Restaurant[]
  amenities    ResortAmenity[]
  offers       Offer[]
  userAccess   UserResortAccess[]
  menuItems    MenuItem[]

  @@index([destinationId, status])

  integration        ResortIntegration?
  cancellationPolicies CancellationPolicy[]
  ratePlans          RatePlan[]
  inventorySnapshots InventorySnapshot[]
  bookingHolds       BookingHold[]
  bookings           Booking[]
  integrationLogs    IntegrationLog[]

  facilities   Facility[]
  policies     ResortPolicy[]
  faqs         Faq[]
  attractions  NearbyAttraction[]
  venues       Venue[]
  reviews      Review[]
  sections     ResortSection[]
  experiences  Experience[]

  @@map("resorts")
}

model ResortTranslation {
  id               String  @id @default(cuid())
  resortId         String
  localeCode       String  @db.VarChar(12)
  name             String
  slug             String
  tagline          String?
  shortDescription String?
  description      String?
  metaTitle        String?
  metaDescription  String?

  resort Resort @relation(fields: [resortId], references: [id], onDelete: Cascade)
  locale Locale @relation(fields: [localeCode], references: [code], onDelete: Cascade)

  @@unique([resortId, localeCode])
  @@unique([localeCode, slug]) // the primary public lookup
  @@map("resort_translations")
}

model ResortMedia {
  resortId     String
  mediaId      String
  displayOrder Int    @default(0)

  resort Resort     @relation(fields: [resortId], references: [id], onDelete: Cascade)
  media  MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([resortId, mediaId])
  @@map("resort_media")
}

// ============================================================
// ROOMS
// ============================================================

model RoomType {
  id           String  @id @default(cuid())
  resortId     String
  externalCode String? // OPERA room type code — nullable until mapping is done,
  //                      so content can go live before the connector exists
  maxAdults    Int     @default(2)
  maxChildren  Int     @default(0)
  maxOccupancy Int     @default(2)
  sizeSqm      Int?
  bedConfig    String?
  displayOrder Int     @default(0)
  active       Boolean @default(true)

  fromRateMinor Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resort       Resort                @relation(fields: [resortId], references: [id], onDelete: Cascade)
  translations RoomTypeTranslation[]
  media        RoomTypeMedia[]

  @@unique([resortId, externalCode])
  @@index([resortId, active])

  ratePlans          RatePlanRoomType[]
  inventorySnapshots InventorySnapshot[]
  bookingRooms       BookingRoom[]

  @@map("room_types")
}

model RoomTypeTranslation {
  id          String  @id @default(cuid())
  roomTypeId  String
  localeCode  String  @db.VarChar(12)
  name        String
  slug        String
  description String?

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  locale   Locale   @relation(fields: [localeCode], references: [code], onDelete: Cascade)

  @@unique([roomTypeId, localeCode])
  @@map("room_type_translations")
}

model RoomTypeMedia {
  roomTypeId   String
  mediaId      String
  displayOrder Int    @default(0)

  roomType RoomType   @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  media    MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([roomTypeId, mediaId])
  @@map("room_type_media")
}

// ============================================================
// AMENITIES, RESTAURANTS, EXPERIENCES
// ============================================================

model Amenity {
  id           String  @id @default(cuid())
  code         String  @unique
  icon         String?
  category     String  @default("general")
  displayOrder Int     @default(0)

  translations AmenityTranslation[]
  resorts      ResortAmenity[]

  @@map("amenities")
}

model AmenityTranslation {
  id         String @id @default(cuid())
  amenityId  String
  localeCode String @db.VarChar(12)
  name       String

  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  locale  Locale  @relation(fields: [localeCode], references: [code], onDelete: Cascade)

  @@unique([amenityId, localeCode])
  @@map("amenity_translations")
}

model ResortAmenity {
  resortId  String
  amenityId String

  resort  Resort  @relation(fields: [resortId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([resortId, amenityId])
  @@map("resort_amenities")
}

model Restaurant {
  id           String  @id @default(cuid())
  resortId     String
  cuisine      String?
  dressCode    String?
  openingHours String?
  /// A menu the guest can open, and where "Reserve a table" goes. Both
  /// optional: a restaurant with neither simply shows no button.
  menuMediaId    String?
  reservationUrl String?
  heroMediaId  String?
  displayOrder Int     @default(0)
  status       String  @default("published")

  resort       Resort                  @relation(fields: [resortId], references: [id], onDelete: Cascade)
  heroMedia    MediaAsset?             @relation("RestaurantHero", fields: [heroMediaId], references: [id])
  menuMedia    MediaAsset?             @relation("RestaurantMenu", fields: [menuMediaId], references: [id])
  translations RestaurantTranslation[]
  gallery      RestaurantMedia[]

  @@index([resortId, status])
  @@map("restaurants")
}

model RestaurantTranslation {
  id           String  @id @default(cuid())
  restaurantId String
  localeCode   String  @db.VarChar(12)
  name         String
  slug         String
  description  String?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  locale     Locale     @relation(fields: [localeCode], references: [code], onDelete: Cascade)

  @@unique([restaurantId, localeCode])
  @@map("restaurant_translations")
}

/// What the coast is actually for. Fills the slot the Destinations module vacated.
model Experience {
  id            String  @id @default(cuid())
  code          String  @unique
  /// Null means the experience belongs to the group and shows on every hotel.
  resortId      String?
  category      String  @default("water") // water | desert | wellness | family
  durationHours Float?
  priceMinor    Int?
  heroMediaId   String?
  displayOrder  Int     @default(0)
  status        String  @default("published")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resort       Resort?                 @relation(fields: [resortId], references: [id], onDelete: SetNull)
  heroMedia    MediaAsset?             @relation("ExperienceHero", fields: [heroMediaId], references: [id])
  translations ExperienceTranslation[]
  menuItems    MenuItem[]

  @@map("experiences")
}

model ExperienceTranslation {
  id           String  @id @default(cuid())
  experienceId String
  localeCode   String  @db.VarChar(12)
  name         String
  slug         String
  summary      String?
  description  String?

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  locale     Locale     @relation(fields: [localeCode], references: [code], onDelete: Cascade)

  @@unique([experienceId, localeCode])
  @@unique([localeCode, slug])
  @@map("experience_translations")
}

// ============================================================
// OFFERS
// ============================================================

model Offer {
  id            String    @id @default(cuid())
  /// Null means group-wide: renders on the homepage and applies at every resort.
  resortId      String?
  promoCode     String?
  discountType  String? // percentage | fixed | value_add
  discountValue Int?
  validFrom     DateTime?
  validTo       DateTime?
  stayFrom      DateTime?
  stayTo        DateTime?
  minNights     Int?
  heroMediaId   String?
  displayOrder  Int       @default(0)
  status        String    @default("published")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resort       Resort?            @relation(fields: [resortId], references: [id], onDelete: Cascade)
  heroMedia    MediaAsset?        @relation("OfferHero", fields: [heroMediaId], references: [id])
  translations OfferTranslation[]
  menuItems    MenuItem[]

  @@index([status, displayOrder])
  @@map("offers")
}

model OfferTranslation {
  id          String  @id @default(cuid())
  offerId     String
  localeCode  String  @db.VarChar(12)
  title       String
  slug        String
  summary     String?
  description String?
  terms       String?
  validityLabel String? // human wording shown on the card, e.g. "Until 20 December"

  offer  Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  locale Locale @relation(fields: [localeCode], references: [code], onDelete: Cascade)

  @@unique([offerId, localeCode])
  @@unique([localeCode, slug])
  @@map("offer_translations")
}

// ============================================================
// CONTENT PAGES  —  block-based, so a new page cannot drift
// ============================================================

model Page {
  id           String    @id @default(cuid())
  key          String    @unique
  template     String    @default("standard")
  status       String    @default("draft") // draft | published | archived
  isSystem     Boolean   @default(false) // system pages cannot be deleted
  publishedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations PageTranslation[]
  menuItems    MenuItem[]

  @@map("pages")
}

model PageTranslation {
  id              String @id @default(cuid())
  pageId          String
  localeCode      String @db.VarChar(12)
  title           String
  slug            String
  /// Ordered array of blocks, each { type, props } — composed from the same
  /// components the homepage uses.
  blocks          Json   @default("[]")
  metaTitle       String?
  metaDescription String?

  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  locale Locale @relation(fields: [localeCode], references: [code], onDelete: Cascade)

  @@unique([pageId, localeCode])
  @@unique([localeCode, slug])
  @@map("page_translations")
}

// ============================================================
// MENUS  —  items point at content, never at URLs
// ============================================================

model Menu {
  id       String @id @default(cuid())
  key      String @unique // primary | utility | footer_a | footer_b | footer_c
  name     String
  maxDepth Int    @default(1)

  items MenuItem[]

  @@map("menus")
}

model MenuItem {
  id         String  @id @default(cuid())
  menuId     String
  parentId   String?
  position   Int     @default(0)

  /// page | resort | room_type | offer | experience | destination | route | url
  targetType String
  pageId       String?
  resortId     String?
  offerId      String?
  experienceId String?
  route        String? // for targetType 'route', e.g. "/resorts"
  url          String? // only for genuinely external links
  anchor       String?

  openNewTab Boolean @default(false)

  /// Not read by anything yet — neither `getMenu` nor the admin builder looks at
  /// these. Left in place for signed-in-only items and in-page anchors, but the
  /// builder deliberately does not offer controls for them: a switch that does
  /// nothing is worse than no switch at all.
  visibility String  @default("always")

  menu         Menu                  @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent       MenuItem?             @relation("MenuItemChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children     MenuItem[]            @relation("MenuItemChildren")
  page         Page?                 @relation(fields: [pageId], references: [id], onDelete: Cascade)
  resort       Resort?               @relation(fields: [resortId], references: [id], onDelete: Cascade)
  offer        Offer?                @relation(fields: [offerId], references: [id], onDelete: Cascade)
  experience   Experience?           @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  translations MenuItemTranslation[]

  @@index([menuId, position])
  @@map("menu_items")
}

/// Label override only. Empty means "use the target's own translated title",
/// which is what stops menus going stale in seven languages at once.
model MenuItemTranslation {
  id         String @id @default(cuid())
  menuItemId String
  localeCode String @db.VarChar(12)
  label      String

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  locale   Locale   @relation(fields: [localeCode], references: [code], onDelete: Cascade)

  @@unique([menuItemId, localeCode])
  @@map("menu_item_translations")
}

// ============================================================
// STAFF, ROLES, AUDIT
// ============================================================

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  firstName      String
  lastName       String
  totpSecret     String?
  totpEnabled    Boolean   @default(false)
  /// The last TOTP step this account signed in with. A code stays valid for
  /// about ninety seconds, so without this a code read over someone's shoulder
  /// can be used a second time. Steps must strictly increase.
  totpLastStep   Int?
  totpEnabledAt  DateTime?
  status         String    @default("active")
  lastLoginAt    DateTime?
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles         UserRole[]
  resortAccess  UserResortAccess[]
  auditEntries  AuditLog[]
  uploads       MediaAsset[]
  translations  TranslationString[]
  recoveryCodes UserRecoveryCode[]

  @@map("users")
}

/// One-time codes for getting back in when the phone is gone.
///
/// Without these, enabling two-factor on the only super admin is one lost
/// phone away from nobody being able to administer the site at all. Stored
/// hashed with the same function as passwords: a leaked table must not hand
/// anyone a way past the second factor.
model UserRecoveryCode {
  id       String    @id @default(cuid())
  userId   String
  codeHash String
  usedAt   DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("user_recovery_codes")
}

model Role {
  key         String @id // SUPER_ADMIN | GROUP_ADMIN | RESORT_ADMIN | RESERVATION_AGENT
  //                        | CONTENT_MANAGER | TRANSLATOR | FINANCE | READ_ONLY
  name        String
  scope       String @default("resort") // group | resort
  description String?

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  key         String @id // e.g. "content:write", "bookings:read"
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleKey       String
  permissionKey String

  role       Role       @relation(fields: [roleKey], references: [key], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleKey, permissionKey])
  @@map("role_permissions")
}

model UserRole {
  userId  String
  roleKey String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleKey], references: [key], onDelete: Cascade)

  @@id([userId, roleKey])
  @@map("user_roles")
}

/// The scoping table. A group-level role with no rows sees every resort;
/// anyone else sees exactly the rows listed. Zero rows is zero access.
model UserResortAccess {
  userId   String
  resortId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  resort Resort @relation(fields: [resortId], references: [id], onDelete: Cascade)

  @@id([userId, resortId])
  @@map("user_resort_access")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/* ==================================================================== *
 * Booking
 *
 * Everything below exists to make one state impossible to reach
 * silently: money taken and no reservation created. See
 * docs/booking-lifecycle.md — this is that document in tables.
 * ==================================================================== */

/// The shared connection to OPERA.
///
/// One row serves all three resorts: they are one multi-property OPERA
/// installation reached through one channel-manager account, so endpoint,
/// credentials and connection health belong here rather than being copied
/// three times. Breaker state lives here too, because an outage on this
/// connection takes every property at once.
model IntegrationEnvironment {
  id              String  @id @default(cuid())
  name            String
  /// ows | oxi | channel_manager | simulator
  integrationType String
  endpoint        String
  chainCode       String?
  /// production | test
  environment     String  @default("test")
  /// A pointer into the secret store. NEVER the credential itself.
  credentialRef   String
  enabled         Boolean @default(false)

  /// closed | open | half_open — the circuit breaker.
  circuitState     String    @default("closed")
  openedAt         DateTime?
  consecutiveFails Int       @default(0)
  lastErrorAt      DateTime?
  lastErrorSummary String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  integrations ResortIntegration[]

  @@map("integration_environments")
}

/// What is genuinely per property: the OPERA resort code, the capability
/// flags, and the sync state. `operaResortCode` is the key that lets one
/// connection serve three resorts.
model ResortIntegration {
  id            String @id @default(cuid())
  resortId      String @unique
  environmentId String

  /// The OPERA resort code. Without it nothing can be routed to a property.
  operaResortCode String?

  /// Capability flags read by the UI, so no code anywhere asks
  /// "is this resort on OPERA?". Shape: ConnectorCapabilities.
  capabilities Json

  enabled     Boolean   @default(false)
  /// live | snapshot — where availability is read from.
  bookingMode String    @default("snapshot")
  lastSyncAt  DateTime?
  syncStatus  String    @default("never")
  lastErrorAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resort      Resort                 @relation(fields: [resortId], references: [id], onDelete: Cascade)
  environment IntegrationEnvironment @relation(fields: [environmentId], references: [id], onDelete: Restrict)

  @@map("resort_integrations")
}

model CancellationPolicy {
  id       String @id @default(cuid())
  resortId String
  /// free_until | non_refundable | partial | custom
  type     String
  freeUntilDays Int?
  freeUntilTime String? // "18:00" local to the property
  /// percentage | nights | fixed
  penaltyType   String?
  penaltyValue  Int?

  resort       Resort                          @relation(fields: [resortId], references: [id], onDelete: Cascade)
  translations CancellationPolicyTranslation[]
  ratePlans    RatePlan[]

  @@map("cancellation_policies")
}

model CancellationPolicyTranslation {
  id         String @id @default(cuid())
  policyId   String
  localeCode String @db.VarChar(12)
  /// The sentence the guest reads at checkout. Written, not generated: a
  /// policy summarised by code is a policy nobody can be held to.
  summary    String

  policy CancellationPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  locale Locale             @relation(fields: [localeCode], references: [code], onDelete: Cascade)

  @@unique([policyId, localeCode])
  @@map("cancellation_policy_translations")
}

model RatePlan {
  id           String  @id @default(cuid())
  resortId     String
  externalCode String? // the OPERA rate code, nullable until mapping is done
  /// room_only | bed_and_breakfast | half_board | full_board | all_inclusive
  mealPlan     String  @default("bed_and_breakfast")
  policyId     String?
  minStay      Int?
  maxStay      Int?
  advanceDays  Int?
  /// false covers corporate and negotiated rates, reachable only by code.
  isPublic     Boolean @default(true)
  active       Boolean @default(true)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resort       Resort                @relation(fields: [resortId], references: [id], onDelete: Cascade)
  policy       CancellationPolicy?   @relation(fields: [policyId], references: [id], onDelete: SetNull)
  translations RatePlanTranslation[]
  roomTypes    RatePlanRoomType[]
  snapshots    InventorySnapshot[]
  bookingRooms BookingRoom[]

  @@unique([resortId, externalCode])
  @@index([resortId, active])
  @@map("rate_plans")
}

model RatePlanTranslation {
  id          String  @id @default(cuid())
  ratePlanId  String
  localeCode  String  @db.VarChar(12)
  name        String
  description String?

  ratePlan RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  locale   Locale   @relation(fields: [localeCode], references: [code], onDelete: Cascade)

  @@unique([ratePlanId, localeCode])
  @@map("rate_plan_translations")
}

model RatePlanRoomType {
  ratePlanId String
  roomTypeId String

  ratePlan RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@id([ratePlanId, roomTypeId])
  @@map("rate_plan_room_types")
}

/// Availability and rates pushed to us by OXI, one row per night.
///
/// This table is doing more work than it looks. It makes group-wide search
/// fast, and it keeps the site searchable when OPERA or the channel manager
/// is down — with one installation behind all three resorts, reading live
/// would take the whole group offline together. Only creating a reservation
/// needs the connection up.
model InventorySnapshot {
  id             String   @id @default(cuid())
  resortId       String
  roomTypeId     String
  ratePlanId     String
  date           DateTime @db.Date
  availableCount Int
  rateMinor      Int
  currency       String   @db.VarChar(3)
  /// { minStay, maxStay, closedToArrival, closedToDeparture, stopSell }
  restrictions   Json?
  /// oxi | manual | simulator — how this row got here.
  source         String   @default("oxi")
  syncedAt       DateTime @default(now())

  resort   Resort   @relation(fields: [resortId], references: [id], onDelete: Cascade)
  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  ratePlan RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  @@unique([resortId, roomTypeId, ratePlanId, date])
  @@index([resortId, date])
  @@index([date, availableCount])
  @@map("inventory_snapshots")
}

model Guest {
  id        String  @id @default(cuid())
  firstName String
  lastName  String
  email     String
  phone     String?
  country   String? @db.VarChar(2)
  locale    String  @db.VarChar(12)
  marketingConsent Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]

  /// Not unique: the same address may book without an account, and forcing
  /// uniqueness here would merge two people who share a family inbox.
  @@index([email])
  @@map("guests")
}

/// Our own guard against stale prices and double submission.
///
/// Not an inventory hold in the property's system unless the connector
/// supports one — it holds the quote, not the room.
model BookingHold {
  id        String   @id @default(cuid())
  resortId  String
  sessionId String
  /// The rooms, dates and occupancy this hold covers.
  payload   Json
  /// The itemised price as quoted. What the guest is shown must be what the
  /// guest pays, and this is the record of what that was.
  quote     Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  resort  Resort   @relation(fields: [resortId], references: [id], onDelete: Cascade)
  booking Booking?

  @@index([expiresAt])
  @@index([sessionId])
  @@map("booking_holds")
}

model Booking {
  id        String @id @default(cuid())
  /// Our human-facing code, e.g. FNT-8F3K2P. Generated by us and stable.
  reference String @unique
  resortId  String
  guestId   String
  holdId    String? @unique

  /// See docs/booking-lifecycle.md §1.
  status String @default("DRAFT")

  /// The channel manager's or OWS's id, returned in the creating call.
  externalReservationId String?
  /// OPERA's own confirmation number. On the OWS path it arrives in the same
  /// call; on an asynchronous path it lands later. Both are stored verbatim
  /// and never regenerated.
  externalConfirmationNumber String?

  checkIn    DateTime @db.Date
  checkOut   DateTime @db.Date
  nights     Int
  adults     Int
  children   Int      @default(0)
  childAges  Int[]
  roomsCount Int      @default(1)

  currency    String @db.VarChar(3)
  roomTotal   Int
  taxesTotal  Int    @default(0)
  feesTotal   Int    @default(0)
  totalAmount Int

  paymentStatus   String  @default("none")
  source          String  @default("web")
  locale          String  @db.VarChar(12)
  promoCode       String?
  offerId         String?
  specialRequests String?

  /// Threads every log line, connector call, payment event and queue job for
  /// this booking attempt. Given one reference, the whole story is
  /// reconstructable from logs alone.
  correlationId String

  /// How many times reservation creation has been attempted, and when it may
  /// next be tried. Kept on the row so a restart does not lose the schedule.
  confirmAttempts Int       @default(0)
  nextAttemptAt   DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  confirmedAt DateTime?
  cancelledAt DateTime?

  resort   Resort         @relation(fields: [resortId], references: [id], onDelete: Restrict)
  guest    Guest          @relation(fields: [guestId], references: [id], onDelete: Restrict)
  hold     BookingHold?   @relation(fields: [holdId], references: [id], onDelete: SetNull)
  rooms         BookingRoom[]
  payments      Payment[]
  events        BookingEvent[]
  notifications BookingNotification[]

  @@index([resortId, checkIn])
  @@index([status, createdAt])
  @@index([status, nextAttemptAt])
  @@map("bookings")
}

model BookingRoom {
  id         String @id @default(cuid())
  bookingId  String
  roomTypeId String
  ratePlanId String

  adults    Int
  children  Int   @default(0)
  childAges Int[]
  quantity  Int   @default(1)

  /// A per-date breakdown, not one number. Without it a modification or a
  /// partial refund six weeks later cannot be priced, and a dispute cannot be
  /// answered.
  nightlyRates Json
  roomTotal    Int
  guestName    String?
  externalLineId String?

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  ratePlan RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@map("booking_rooms")
}

/// Append-only. Every transition lands here.
///
/// This is what makes a payment/reservation inconsistency investigable at
/// 2am, and it is the trail finance will ask for.
model BookingEvent {
  id         String  @id @default(cuid())
  bookingId  String
  type       String
  fromStatus String?
  toStatus   String?
  /// guest | system | staff | provider
  actorType  String
  actorId    String?
  payload    Json?
  correlationId String

  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_events")
}

model Payment {
  id                String  @id @default(cuid())
  bookingId         String
  provider          String
  providerPaymentId String?
  idempotencyKey    String  @unique

  amount   Int
  currency String @db.VarChar(3)
  status   String @default("INITIATED")
  method   String?
  /// Last four digits only. No raw card data is ever stored, anywhere.
  last4    String? @db.VarChar(4)
  /// Redacted at write time, for reconciliation only.
  rawResponse Json?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  capturedAt DateTime?
  refundedAt DateTime?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([providerPaymentId])
  @@map("payments")
}

/// Guards payment creation, reservation creation and webhook processing
/// against double-clicks, refreshes, retries and duplicate deliveries.
///
/// The first response for a key is stored and replayed for repeats. No retry
/// may ever create a second charge or a second reservation.
model IdempotencyKey {
  key         String   @id
  scope       String
  requestHash String
  response    Json?
  status      String   @default("in_progress")
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Summaries only, credentials redacted at write time.
///
/// Surfaced in admin so the reservations team can see what failed without
/// ever seeing a secret.
model IntegrationLog {
  id            String  @id @default(cuid())
  resortId      String?
  connector     String
  operation     String
  correlationId String
  requestSummary  Json?
  responseSummary Json?
  status        String
  durationMs    Int?
  errorCode     String?

  createdAt DateTime @default(now())

  resort Resort? @relation(fields: [resortId], references: [id], onDelete: SetNull)

  @@index([correlationId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@map("integration_logs")
}

/// Reservations the simulator has "created".
///
/// In the database rather than in memory on purpose: a simulator that forgets
/// when the process restarts, or that keeps separate memories in the web
/// server and a worker, cannot stand in for an external system. In particular
/// it could not exercise the case this whole design exists for — a reservation
/// that already exists when the retry comes back.
///
/// Only ever written by the simulator connector. On a production environment
/// running against real OPERA this table stays empty.
model SimulatorReservation {
  reference          String   @id
  resortId           String
  externalReservationId String @unique
  confirmationNumber String
  status             String   @default("confirmed")
  checkIn            String
  checkOut           String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("simulator_reservations")
}

/// Messages waiting to go out.
///
/// An outbox rather than a call at the moment of the transition. Sending
/// inline means an SMTP hiccup either loses a guest's confirmation or, if
/// retried naively, sends it twice — and it puts a slow network call inside a
/// database transaction. A row here is written with the transition; the worker
/// drains it, retries what failed, and gives up loudly rather than silently.
model BookingNotification {
  id        String @id @default(cuid())
  bookingId String
  /// confirmed | pending_confirmation | needs_review | cancelled
  kind      String
  /// email — SMS may follow, and the kind is what the template keys on.
  channel   String @default("email")
  recipient String
  locale    String @db.VarChar(12)

  status      String    @default("pending") // pending | sent | failed
  attempts    Int       @default(0)
  lastError   String?
  nextAttemptAt DateTime @default(now())
  sentAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  /// One message of each kind per booking. A retried transition, a duplicated
  /// webhook, or a staff member pressing a button twice must not mean two
  /// confirmation emails to the same guest.
  @@unique([bookingId, kind, channel])
  @@index([status, nextAttemptAt])
  @@map("booking_notifications")
}

// ---------------------------------------------------------------------------
// Hotel detail page
//
// Everything the internal hotel page shows that had nowhere to live: the
// brand, the facilities, the policies, the FAQs, what is nearby, the event
// venues, the guest scores, and which sections a given hotel shows at all.
//
// Two things deliberately NOT added here:
//
//   Country and City. Destination already carries a country code, coordinates
//   and translated name and slug — it is the city. A second pair of models
//   would be two more places for the same fact to disagree.
//
//   A media table per entity. MediaAsset plus a join is the pattern the
//   resort gallery already uses, and every gallery below reuses it.
// ---------------------------------------------------------------------------

/// A hotel brand. Optional throughout: a single-brand group leaves it unset
/// and no page changes.
model Brand {
  id           String  @id @default(cuid())
  code         String  @unique
  logoMediaId  String?
  heroMediaId  String?
  displayOrder Int     @default(0)
  status       String  @default("published")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logoMedia    MediaAsset?        @relation("BrandLogo", fields: [logoMediaId], references: [id])
  heroMedia    MediaAsset?        @relation("BrandHero", fields: [heroMediaId], references: [id])
  translations BrandTranslation[]
  resorts      Resort[]

  @@map("brands")
}

model BrandTranslation {
  id          String  @id @default(cuid())
  brandId     String
  localeCode  String  @db.VarChar(12)
  name        String
  slug        String
  tagline     String?
  description String?

  brand  Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  locale Locale @relation(fields: [localeCode], references: [code], onDelete: Cascade)

  @@unique([brandId, localeCode])
  @@index([localeCode, slug])
  @@map("brand_translations")
}

/// A facility at one hotel: pool, spa, gym, kids club. Distinct from Amenity,
/// which is a checklist tick shared across hotels — a facility has its own
/// description, hours and photograph.
model Facility {
  id           String  @id @default(cuid())
  resortId     String
  category     String  @default("general") // wellness | leisure | family | services | business
  icon         String?
  openingHours String?
  heroMediaId  String?
  displayOrder Int     @default(0)
  status       String  @default("published")

  resort       Resort                @relation(fields: [resortId], references: [id], onDelete: Cascade)
  heroMedia    MediaAsset?           @relation("FacilityHero", fields: [heroMediaId], references: [id])
  translations FacilityTranslation[]

  @@index([resortId, status])
  @@map("facilities")
}

model FacilityTranslation {
  id          String  @id @default(cuid())
  facilityId  String
  localeCode  String  @db.VarChar(12)
  name        String
  description String?

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  locale   Locale   @relation(fields: [localeCode], references: [code], onDelete: Cascade)

  @@unique([facilityId, localeCode])
  @@map("facility_translations")
}

/// House rules. Separate from CancellationPolicy, which the booking engine
/// enforces — these are text a guest reads, not terms code applies.
model ResortPolicy {
  id           String @id @default(cuid())
  resortId     String
  category     String @default("general") // arrival | children | pets | payment | smoking
  displayOrder Int    @default(0)

  resort       Resort                    @relation(fields: [resortId], references: [id], onDelete: Cascade)
  translations ResortPolicyTranslation[]

  @@index([resortId])
  @@map("resort_policies")
}

model ResortPolicyTranslation {
  id         String @id @default(cuid())
  policyId   String
  localeCode String @db.VarChar(12)
  title      String
  body       String

  policy ResortPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  locale Locale       @relation(fields: [localeCode], references: [code], onDelete: Cascade)

  @@unique([policyId, localeCode])
  @@map("resort_policy_translations")
}

/// A question and its answer. resortId null means it applies to the whole
/// group and shows on every hotel.
model Faq {
  id           String  @id @default(cuid())
  resortId     String?
  category     String  @default("general") // booking | arrival | dining | facilities
  displayOrder Int     @default(0)
  status       String  @default("published")

  resort       Resort?          @relation(fields: [resortId], references: [id], onDelete: Cascade)
  translations FaqTranslation[]

  @@index([resortId, status])
  @@map("faqs")
}

model FaqTranslation {
  id         String @id @default(cuid())
  faqId      String
  localeCode String @db.VarChar(12)
  question   String
  answer     String

  faq    Faq    @relation(fields: [faqId], references: [id], onDelete: Cascade)
  locale Locale @relation(fields: [localeCode], references: [code], onDelete: Cascade)

  @@unique([faqId, localeCode])
  @@map("faq_translations")
}

/// Somewhere worth going near a hotel. Distance and travel time are stored
/// rather than computed: the useful number is by road, and a straight line
/// between two coordinates is not that.
model NearbyAttraction {
  id             String  @id @default(cuid())
  resortId       String
  kind           String  @default("attraction") // airport | city | landmark | shopping | transport
  distanceKm     Float?
  travelMinutes  Int?
  latitude       Float?
  longitude      Float?
  heroMediaId    String?
  displayOrder   Int     @default(0)

  resort       Resort                        @relation(fields: [resortId], references: [id], onDelete: Cascade)
  heroMedia    MediaAsset?                   @relation("AttractionHero", fields: [heroMediaId], references: [id])
  translations NearbyAttractionTranslation[]

  @@index([resortId])
  @@map("nearby_attractions")
}

model NearbyAttractionTranslation {
  id           String  @id @default(cuid())
  attractionId String
  localeCode   String  @db.VarChar(12)
  name         String
  description  String?

  attraction NearbyAttraction @relation(fields: [attractionId], references: [id], onDelete: Cascade)
  locale     Locale           @relation(fields: [localeCode], references: [code], onDelete: Cascade)

  @@unique([attractionId, localeCode])
  @@map("nearby_attraction_translations")
}

/// A meetings and events space.
model Venue {
  id           String  @id @default(cuid())
  resortId     String
  areaSqm      Float?
  ceilingM     Float?
  daylight     Boolean @default(false)
  heroMediaId  String?
  displayOrder Int     @default(0)
  status       String  @default("published")

  resort       Resort             @relation(fields: [resortId], references: [id], onDelete: Cascade)
  heroMedia    MediaAsset?        @relation("VenueHero", fields: [heroMediaId], references: [id])
  translations VenueTranslation[]
  layouts      VenueLayout[]
  gallery      VenueMedia[]

  @@index([resortId, status])
  @@map("venues")
}

model VenueTranslation {
  id          String  @id @default(cuid())
  venueId     String
  localeCode  String  @db.VarChar(12)
  name        String
  slug        String
  description String?
  equipment   String?

  venue  Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  locale Locale @relation(fields: [localeCode], references: [code], onDelete: Cascade)

  @@unique([venueId, localeCode])
  @@index([localeCode, slug])
  @@map("venue_translations")
}

/// Capacity depends entirely on how the room is laid out, so it is stored per
/// layout rather than as one number on the venue.
model VenueLayout {
  id       String @id @default(cuid())
  venueId  String
  layout   String // theatre | classroom | banquet | ushape | boardroom | reception | cabaret
  capacity Int

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, layout])
  @@map("venue_layouts")
}

model VenueMedia {
  venueId      String
  mediaId      String
  displayOrder Int    @default(0)

  venue Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  media MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([venueId, mediaId])
  @@map("venue_media")
}

/// A guest review. Scores are stored per category; the overall figure shown on
/// the page is derived, never a second number that can drift from its parts.
///
/// `source` records where it came from, because a review imported from a
/// travel site and one left here are not equally verifiable and should never
/// be presented as if they were.
model Review {
  id          String   @id @default(cuid())
  resortId    String
  bookingId   String?
  source      String   @default("direct") // direct | imported
  guestName   String
  guestCountry String?
  stayedAt    DateTime?
  title       String?
  body        String
  localeCode  String   @db.VarChar(12)
  status      String   @default("pending") // pending | published | rejected
  publishedAt DateTime?

  createdAt DateTime @default(now())

  resort Resort              @relation(fields: [resortId], references: [id], onDelete: Cascade)
  scores ReviewCategoryScore[]

  @@index([resortId, status, publishedAt])
  @@map("reviews")
}

model ReviewCategoryScore {
  reviewId String
  category String // cleanliness | location | service | facilities | value
  score    Int // 1–10

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@id([reviewId, category])
  @@map("review_category_scores")
}

/// Which sections a hotel shows, and in what order.
///
/// Per hotel rather than global: a resort with no spa should not display an
/// empty facilities heading, and a resort with no venues should not advertise
/// meetings. A missing row means the section's default, so adding a section in
/// code does not require a row for every existing hotel.
model ResortSection {
  resortId     String
  section      String // overview | gallery | rooms | facilities | dining | offers | venues | experiences | location | attractions | policies | reviews | faq | contact | related
  enabled      Boolean @default(true)
  displayOrder Int     @default(0)

  resort Resort @relation(fields: [resortId], references: [id], onDelete: Cascade)

  @@id([resortId, section])
  @@map("resort_sections")
}

model RestaurantMedia {
  restaurantId String
  mediaId      String
  displayOrder Int    @default(0)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  media      MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([restaurantId, mediaId])
  @@map("restaurant_media")
}
