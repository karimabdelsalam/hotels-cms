# Local development
DATABASE_URL="postgresql://fantazia:fantazia@127.0.0.1:5432/fantazia?schema=public"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
AUTH_SECRET="dev-only-change-me-in-production-min-32-chars"
# MEDIA_ROOT — where uploads are written. MUST be absolute: both apps read it,
# and a relative path resolves against each app's own working directory.
# On cPanel, point this at a directory under public_html so the web server
# serves the files directly and Node stays out of the request path.
MEDIA_ROOT="/var/www/fantazia/media"
# NEXT_PUBLIC_MEDIA_URL_BASE — set when the web server serves MEDIA_ROOT directly.
# Leave unset in development; the apps stream from /media themselves.

# Lets the admin clear the public site's cache immediately after publishing,
# instead of waiting out the ISR window. Generate with: openssl rand -hex 32
REVALIDATE_SECRET="change-me"
# Where the admin reaches the public app internally.
WEB_URL="http://127.0.0.1:3000"
ANTHROPIC_API_KEY=""
