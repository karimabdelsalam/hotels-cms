# Copy to <account home>/public_html/media/.htaccess
#
# This directory is written to by the public through the upload form. Nothing in
# it should ever be executed, whatever extension a file arrives with.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .cgi .pl
php_flag engine off

# Storage keys are unique per upload, so the bytes at a URL never change.
<IfModule mod_headers.c>
    Header always set Cache-Control "public, max-age=31536000, immutable"
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
