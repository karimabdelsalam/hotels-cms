# Production environment. Copy to .env on the server and fill in.
# Never commit the real file — it holds the session secret and database password.

NODE_ENV="production"

# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://fantazia:CHANGE_ME@127.0.0.1:5432/fantazia?schema=public&connection_limit=10"

# --- Sessions ---------------------------------------------------------------
# Generate with: openssl rand -base64 48
# Changing it signs every staff member out, which is also how you revoke a
# leaked session in a hurry.
AUTH_SECRET="CHANGE_ME_AT_LEAST_32_CHARACTERS"

# --- Public site ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://fantaziahotels.com"

# --- Media ------------------------------------------------------------------
# Absolute path. Both apps read it, and a relative path resolves against each
# app's own working directory — the apps would not share it.
#
# On cPanel this goes INSIDE public_html so Apache serves it with no extra
# configuration. The application source must stay OUTSIDE public_html, since
# everything under the document root is downloadable and this file is secret.
MEDIA_ROOT="/home/fantazia/public_html/media"
# Set this so Apache serves the files directly and Node stays out of the
# request path. Must match the Alias in infra/apache/fantazia.conf.
NEXT_PUBLIC_MEDIA_URL_BASE="https://fantaziahotels.com/media"

# --- Cache ------------------------------------------------------------------
# Lets the admin clear the public site's cache immediately after publishing.
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET="CHANGE_ME"
WEB_URL="http://127.0.0.1:3000"

# --- Automatic translation --------------------------------------------------
# Optional. Without it the Translation Manager still works; the AI buttons say
# they are not configured rather than failing.
ANTHROPIC_API_KEY=""
